# ─── PostgreSQL ───────────────────────────────────
POSTGRES_DB=digital_library
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-db-password

# ─── Spring Boot JWT ──────────────────────────────
APP_JWT_SECRET=your-256-bit-or-longer-jwt-secret-key-here
APP_JWT_EXPIRATION_MS=86400000
APP_JWT_REFRESH_EXPIRATION_DAYS=7

# ─── Storage (local fallback) ─────────────────────
APP_STORAGE_LOCAL_FOLDER=local-storage

# ─── Redis ────────────────────────────────────────
# Automatically set to 'redis' container in docker-compose
REDIS_HOST=redis
REDIS_PORT=6379
# Use 'redis' for production or 'simple' for in-memory local dev
SPRING_CACHE_TYPE=simple

# ─── AWS ──────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=digital-library-storage
AWS_SES_FROM_EMAIL=noreply@digitallibrary.com
AWS_SNS_SENDER_ID=DIGILIB
# Set to false in production with real AWS credentials
AWS_MOCK_ENABLED=true

# ─── Rate Limiting ────────────────────────────────
# Requests per minute per IP (default: 60)
# app.rate-limit.requests-per-minute=60