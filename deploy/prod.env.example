# Template for deploy/prod.env — this file is generated by deploy-app.py and is gitignored
# because it contains live secrets. Keep this example in sync with what that script writes.

POSTGRES_DB=digital_library
POSTGRES_USER=dlibadmin
POSTGRES_PASSWORD=set-via-DB_MASTER_PASSWORD-env-var

APP_JWT_SECRET=set-via-APP_JWT_SECRET-env-var
APP_JWT_EXPIRATION_MS=86400000
APP_JWT_REFRESH_EXPIRATION_DAYS=7
APP_STORAGE_LOCAL_FOLDER=local-storage

APP_CORS_ALLOWED_ORIGINS=http://<ec2-public-ip>:3000

AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=your-digital-library-books-storage
AWS_SES_FROM_EMAIL=noreply@digitallibrary.com
AWS_MOCK_ENABLED=false

REDIS_HOST=redis
REDIS_PORT=6379
SPRING_CACHE_TYPE=redis
